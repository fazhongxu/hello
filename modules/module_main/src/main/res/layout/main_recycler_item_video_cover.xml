<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>

        <variable
            name="viewModel"
            type="com.xxl.hello.main.ui.main.adapter.VideoCoverRecycleItemViewModel" />

        <variable
            name="listener"
            type="com.xxl.hello.main.ui.main.adapter.VideoCoverRecycleItemListener" />
    </data>

    <RelativeLayout
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_margin="8dp"
        android:onClick="@{() -> listener.onCoverClick(viewModel.targetItemEntity)}">

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@id/iv_cover"
            android:background="@android:color/black"
            android:alpha="0.8">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="2dp"
                android:text="@{viewModel.observableTitle}"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_title"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="2dp"
                android:text="@{viewModel.observableSubtitle}"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/iv_selected"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="4dp"
                android:visibility="@{viewModel.observableSelected ? View.VISIBLE : View.GONE}" />

        </RelativeLayout>

    </RelativeLayout>

</layout>
