<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="listener"
            type="com.xxl.hello.main.ui.main.adapter.OnTestRecycleItemListener" />

        <variable
            name="viewModel"
            type="com.xxl.hello.main.ui.main.adapter.multi.TestRecycleItemViewModel" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:id="@+id/ll_root_container"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:background="@color/resources_primary_color"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_photo"
            android:layout_width="220dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:foreground="?attr/selectableItemBackground"
            android:onClick="@{(v)->listener.onMediaItemClick(viewModel.itemEntity,v)}"
            android:scaleType="fitXY"
            />

    </LinearLayout>

</layout>
