<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.xxl.hello.main.ui.main.MainViewModel" />

        <variable
            name="navigator"
            type="com.xxl.hello.main.ui.main.MainNavigator" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Sticky collapse demo via AppBarLayout + custom Behaviors:
             announcement(red1, scrollFlags=scroll) -> search(blue1, sticky) -> mode tab(red2, scrollFlags=scroll)
             -> category tab(blue2, sticky) -> view pager content -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/sticky_collapse_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:elevation="0dp"
                app:layout_behavior="com.xxl.hello.widget.ui.view.sticky.StickyAppBarBehavior">

                <!-- red 1: announcement (collapse) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#FDE8E8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    app:layout_scrollFlags="scroll">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/resources_sticky_collapse_announcement"
                        android:textColor="#8A4B00"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="@string/resources_sticky_collapse_tag_red_collapse"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- blue 1: search bar (sticky, no scrollFlags; elevation keeps it above sliding red blocks) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#E7F1FD"
                    android:elevation="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineProvider="none"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:background="@drawable/main_bg_sticky_collapse_search"
                        android:gravity="center_vertical"
                        android:paddingLeft="12dp"
                        android:text="@string/resources_sticky_collapse_search_tips"
                        android:textColor="#999999"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="@string/resources_sticky_collapse_tag_blue_sticky"
                        android:textColor="#1565C0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- red 2: display mode tab (collapse) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#FDE8E8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    app:layout_scrollFlags="scroll">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_mode_album"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/resources_sticky_collapse_mode_album"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_mode_dynamic"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/resources_sticky_collapse_mode_dynamic"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_mode_gallery"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/resources_sticky_collapse_mode_gallery"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="@string/resources_sticky_collapse_tag_red2_collapse"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- blue 2: category tab (sticky, no scrollFlags; elevation keeps it above sliding red blocks) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#E7F1FD"
                    android:elevation="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineProvider="none"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_category_all"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/resources_sticky_collapse_category_all"
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_category_sale"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/resources_sticky_collapse_category_sale"
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_category_compare"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/resources_sticky_collapse_category_compare"
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_category_price"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/resources_sticky_collapse_category_price"
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="@string/resources_sticky_collapse_category_filter"
                        android:textColor="#666666"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="@string/resources_sticky_collapse_tag_blue2_sticky"
                        android:textColor="#1565C0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>

            <!-- content: view pager with three list pages -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.xxl.hello.widget.ui.view.sticky.StickyContentBehavior" />
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ctl_content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="@{viewModel.observableUserInfo}"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="user info"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/ll_record_container"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                tools:text="" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_test"
                style="@style/TextStyle.Content.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:onClick="@{()->navigator.onTestClick()}"
                android:onLongClick="@{()->navigator.onTestLongClick()}"
                android:text="@{viewModel.observableUserId}"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="test" />

            <FrameLayout
                android:layout_width="300dp"
                android:layout_height="400dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.xxl.hello.widget.ui.view.test.TestPathImageView
                    android:id="@+id/iv_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/ll_record_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="@{viewModel.observable1 &amp;&amp; viewModel.observable2 ?View.VISIBLE:View.GONE}"
                app:layout_constraintBottom_toTopOf="@+id/tv_test"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                tools:visibility="gone">

                <com.xxl.hello.widget.ui.view.record.RecordButton
                    android:id="@+id/recordBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:visibility="visible"
                    app:buttonColor="#56BF6C"
                    app:buttonGap="2dp"
                    app:buttonRadius="33dp"
                    app:buttonRunningColor="#FFFFFF"
                    app:layout_constraintBottom_toTopOf="@+id/tv_test"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:maxMillisecond="60000"
                    app:progressColor="#56BF6C"
                    app:progressEmptyColor="#4D56BF6C"
                    app:progressNormalColor="#F5F6F6"
                    app:progressStroke="15"
                    app:recordIcon="@mipmap/ic_voice_white"
                    app:stopIcon="@mipmap/ic_audio_record_stop" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_delete_latest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="delete latest" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_complete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="complete" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.xxl.core.widget.recyclerview.UISmartRefreshLayout
            android:id="@+id/refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:listitem="@layout/main_recycler_item_test_binding" />

        </com.xxl.core.widget.recyclerview.UISmartRefreshLayout>

    </LinearLayout>

</layout>
